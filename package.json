{
  "name": "sinima",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/refresh.ts --fixtures",
    "build": "next build",
    "lint": "eslint . && node scripts/check-tokens.mjs",
